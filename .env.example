# Copy to .env and fill in. GOOGLE_API_KEY is required for any LLM-backed
# system (Detection, Threat Assessment, Containment, On-Call).

# --- Model credentials ---------------------------------------------------
# One Google key covers all agents (everything routes through LiteLLM).
GOOGLE_API_KEY=
# Extra providers for cross-provider LLM fallback (Phase 2). Optional but
# recommended -- without them the routing chains run Gemini-only.
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- LLM routing chains (Phase 2) ----------------------------------------
# Comma-separated "provider/model" in priority order; keyless providers (and
# Ollama with no local server) are pruned automatically.
LLM_CHAIN_REASONING=gemini/gemini-2.5-flash,gemini/gemini-3.5-flash-lite
LLM_CHAIN_MECHANICAL=ollama/llama3.1:8b,gemini/gemini-flash-lite-latest
# OLLAMA_API_BASE=http://localhost:11434   # run `ollama serve` to enable local

# --- Notifications (Phase 2 On-Call) -------------------------------------
# On-Call's Notification Agent posts here. Without it, notifications fall back
# to a local file sink (logged, not sent) -- see docs/PHASE2_REPORT.md.
# ONCALL_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ONCALL_ACK_TIMEOUT_SECONDS=120

# --- Incident store ------------------------------------------------------
INCIDENT_STORE_DSN=postgresql://crisis:crisis_dev_pw@localhost:5433/incidents

# --- Target app ----------------------------------------------------------
PORT=8080
# TARGET_APP_URL=https://crisis-target-app-xxxxx.run.app

# --- Ports ---------------------------------------------------------------
DETECTION_PORT=9101
THREAT_ASSESSMENT_PORT=9102
CONTAINMENT_PORT=9103
ONCALL_PORT=9104
FORENSICS_PORT=9105
